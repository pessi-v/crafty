<style>
  .radio-widget {
    position: absolute;
    left: 50px;
    bottom: 50px;
    /* opacity: 0.75; */
    width: 100px;
    height: 89px;
    /* background: #f5f5f0; */
    border: 4px solid #000;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    --color-btn-accent: #405ab0ff;
    color: black;
    cursor: var(--cursor-pointer);

    /* reset */
    line-height: 0 !important;
  }

  .radio-widget__play-pause {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-grow: 4;
    cursor: var(--cursor-pointer);

    /* reset */
    line-height: 0 !important;
  }

  .radio-widget__play-pause-btn:active {
    cursor: var(--cursor-click);
  }

  .radio-widget__play-pause-btn {
    width: 100%;
    height: 100%;
    font-size: 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 600;
    transition: transform 0.1s ease;
    cursor: var(--cursor-pointer);
  }

  .radio-widget__play-pause-btn.playing {
    background: var(--color-btn-accent);
  }

  .radio-widget__channels {
    display: flex;
    border-top: 4px solid #000;
    flex-grow: 2;
    cursor: var(--cursor-pointer);

    /* reset */
    line-height: 0 !important;
  }

  .radio-widget__channels-btn:active {
    cursor: var(--cursor-click);
  }

  .radio-widget__channels-btn {
    flex: 1;
    font-size: 12px;
    font-weight: bold;
    border-right: 4px solid #000;
    cursor: var(--cursor-pointer);
  }

  .radio-widget__channels-btn:last-child {
    border-right: none;
  }

  .radio-widget__channels-btn.active {
    background: var(--color-btn-accent);
  }
</style>


<div class="radio-widget">
  <div class="radio-widget__play-pause">
    <button class="radio-widget__play-pause-btn" id="playPauseBtn">▶</button>
  </div>
  <div class="radio-widget__channels">
    <button class="radio radio-widget__channels-btn active" data-channel="1">1</button>
    <button class="radio radio-widget__channels-btn" data-channel="2">2</button>
    <button class="radio radio-widget__channels-btn" data-channel="3">3</button>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/howler/2.2.4/howler.min.js"></script>
<script>
  const channels = {
    1: 'https://stream-relay-geo.ntslive.net/stream',
    2: 'https://stream-relay-geo.ntslive.net/stream2',
    3: 'https://stream-relay-geo.ntslive.net/stream3'
  };

  let sound = null;
  let currentChannel = 1;
  let isPlaying = false;

  const playPauseBtn = document.getElementById('playPauseBtn');
  const channelBtns = document.querySelectorAll('.radio-widget__channels-btn');

  function initSound() {
    if (!sound) {
      sound = new Howl({
        src: [channels[currentChannel]],
        html5: true
      });
    }
  }

  function play() {
    initSound();
    sound.play();
    isPlaying = true;
    playPauseBtn.textContent = '⏸';
    playPauseBtn.classList.add('playing');
  }

  function pause() {
    if (sound) {
      sound.pause();
    }
    isPlaying = false;
    playPauseBtn.textContent = '▶';
    playPauseBtn.classList.remove('playing');
  }

  function switchChannel(channel) {
    const wasPlaying = isPlaying;

    if (sound) {
      sound.stop();
      sound.unload();
      sound = null;
    }

    currentChannel = channel;

    channelBtns.forEach(btn => {
      btn.classList.toggle('active', btn.dataset.channel == channel);
    });

    if (wasPlaying) {
      play();
    }
  }

  playPauseBtn.addEventListener('click', () => {
    if (isPlaying) {
      pause();
    } else {
      play();
    }
  });

  channelBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      switchChannel(parseInt(btn.dataset.channel));
    });
  });
</script>