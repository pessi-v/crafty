<style>
  .radio-widget {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  
    /* --color-btn-accent:rgba(193, 71, 134, 0.8); */
    --color-btn-accent:rgba(146, 78, 111, 0.8);
    /* --color-btn-accent: #c14786ff; */
    /* --color-btn-accent: #405ab0ff; */
    color: black;

    /* reset */
    line-height: 0 !important;
  }

  .radio-widget__play-pause {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-grow: 4;

    /* reset */
    line-height: 0 !important;
  }

  .radio-widget__play-pause-btn {
    line-height: 0 !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 600;
    transition: transform 0.1s ease;
  }

  .radio-widget__channels {
    display: flex;
    border-top: inherit;
    flex-grow: 2;

    /* reset */
    line-height: 0 !important;
  }

  .radio-widget__channels-btn {
    flex: 1;
    line-height: 0 !important;
    border-color: inherit;
  }

  .radio-widget__channels-btn:last-child {
    border-right: none;
  }
  
  .radio-widget__channels-btn.active {
    background: var(--color-btn-accent);
  }

  .playing {
    background: var(--color-btn-accent);
  }
</style>


<div class="radio-widget left-4 bottom-4 md:left-9 md:bottom-9 absolute w-16 h-14 md:w-24 md:h-20 border-2 rounded-xl md:border-4 md:rounded-2xl">
  <div class="radio-widget__play-pause bg-opacity-10 text-3xl md:text-4xl clickable" id="playPauseBtn">
    <button class="radio-widget__play-pause-btn clickable">▶</button>
  </div>
  <div class="radio-widget__channels bg-opacity-90">
    <button class="radio radio-widget__channels-btn bg-opacity-10 active border-r-2 md:border-r-4 text-sm md:text-lg font-bold" data-channel="1">1</button>
    <button class="radio radio-widget__channels-btn bg-opacity-10 text-sm md:text-lg font-bold" data-channel="2">2</button>
    {# <button class="radio radio-widget__channels-btn" data-channel="3">3</button> #}
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/howler/2.2.4/howler.min.js"></script>
<script>
  const channels = {
    1: 'https://stream-relay-geo.ntslive.net/stream',
    2: 'https://stream-relay-geo.ntslive.net/stream2',
    3: 'https://stream-relay-geo.ntslive.net/stream3'
  };

  let sound = null;
  let currentChannel = 1;
  let isPlaying = false;

  const playPauseBtn = document.getElementById('playPauseBtn');
  const channelBtns = document.querySelectorAll('.radio-widget__channels-btn');

  function initSound() {
    if (!sound) {
      sound = new Howl({
        src: [channels[currentChannel]],
        html5: true
      });
    }
  }

  function play() {
    initSound();
    sound.play();
    isPlaying = true;
    playPauseBtn.textContent = '⏸';
    playPauseBtn.classList.add('playing');
  }

  function pause() {
    if (sound) {
      sound.pause();
    }
    isPlaying = false;
    playPauseBtn.textContent = '▶';
    playPauseBtn.classList.remove('playing');
  }

  function switchChannel(channel) {
    const wasPlaying = isPlaying;

    if (sound) {
      sound.stop();
      sound.unload();
      sound = null;
    }

    currentChannel = channel;

    channelBtns.forEach(btn => {
      btn.classList.toggle('active', btn.dataset.channel == channel);
    });

    if (wasPlaying) {
      play();
    }
  }

  playPauseBtn.addEventListener('click', () => {
    if (isPlaying) {
      pause();
    } else {
      play();
    }
  });

  channelBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      switchChannel(parseInt(btn.dataset.channel));
    });
  });
</script>