<style>
    /* body {
      margin: 0;
      padding: 0;
      height: 100vh;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      display: flex;
      align-items: flex-end;
      padding: 40px;
    } */

    .radio-widget {
      position: absolute;
      left: 50px;
      bottom: 50px;
      opacity: 0.75;
      width: 100px;
      height: 100px;
      background: #f5f5f0;
      border: 2px solid #000;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .play-pause-section {
      flex: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .channel-section {
      flex: 1;
      display: flex;
      border-top: 2px solid #000;
    }

    button {
      background: #f5f5f0;
      border: none;
      cursor: pointer;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-weight: 600;
      transition: transform 0.1s ease;
    }

    button:active {
      transform: scale(0.95);
    }

    .play-pause-btn {
      width: 100%;
      height: 100%;
      font-size: 40px;
    }

    .channel-btn {
      flex: 1;
      font-size: 12px;
      border-right: 2px solid #000;
    }

    .channel-btn:last-child {
      border-right: none;
    }

    .channel-btn.active {
      background: #ddd;
    }

    .play-pause-btn.playing {
      background: #e8e8e0;
    }
  </style>


<div class="radio-widget">
  <div class="play-pause-section">
    <button class="play-pause-btn" id="playPauseBtn">▶</button>
  </div>
  <div class="channel-section">
    <button class="radio channel-btn active" data-channel="1">1</button>
    <button class="radio channel-btn" data-channel="2">2</button>
    <button class="radio channel-btn" data-channel="3">3</button>
  </div>
</div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/howler/2.2.4/howler.min.js"></script>
  <script>
    const channels = {
      1: 'https://stream-relay-geo.ntslive.net/stream',
      2: 'https://stream-relay-geo.ntslive.net/stream2',
      3: 'https://stream-relay-geo.ntslive.net/stream3'
    };

    let sound = null;
    let currentChannel = 1;
    let isPlaying = false;

    const playPauseBtn = document.getElementById('playPauseBtn');
    const channelBtns = document.querySelectorAll('.channel-btn');

    function initSound() {
      if (!sound) {
        sound = new Howl({
          src: [channels[currentChannel]],
          html5: true
        });
      }
    }

    function play() {
      initSound();
      sound.play();
      isPlaying = true;
      playPauseBtn.textContent = '⏸';
      playPauseBtn.classList.add('playing');
    }

    function pause() {
      if (sound) {
        sound.pause();
      }
      isPlaying = false;
      playPauseBtn.textContent = '▶';
      playPauseBtn.classList.remove('playing');
    }

    function switchChannel(channel) {
      const wasPlaying = isPlaying;

      if (sound) {
        sound.stop();
        sound.unload();
        sound = null;
      }

      currentChannel = channel;

      channelBtns.forEach(btn => {
        btn.classList.toggle('active', btn.dataset.channel == channel);
      });

      if (wasPlaying) {
        play();
      }
    }

    playPauseBtn.addEventListener('click', () => {
      if (isPlaying) {
        pause();
      } else {
        play();
      }
    });

    channelBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        switchChannel(parseInt(btn.dataset.channel));
      });
    });
  </script>