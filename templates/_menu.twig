<style>

/* Hamburger Menu Icon Hover Effect */
#hamburger-menu-icon {
  transition: transform 0.2s ease;
}

#hamburger-menu-icon * {
  cursor: var(--cursor-pointer);
}

#hamburger-menu-icon:active * {
  cursor: var(--cursor-click);
}

#hamburger-menu-icon svg #top_bun {
  stroke: none;
  fill: none;
  transition:
    fill 0.3s ease,
    stroke 0.3s ease;
}

#hamburger-menu-icon svg #seeds path {
  fill: #000000;
}

#hamburger-menu-icon svg #cheese,
#hamburger-menu-icon svg #patty path,
#hamburger-menu-icon svg #btm_bun,
#hamburger-menu-icon svg #seeds {
  fill: none;
  stroke: #000000;
  transition:
    fill 0.3s ease,
    stroke 0.3s ease;
}

#cheese {
  fill: none;
}

#hamburger-menu-icon:hover svg #cheese {
  fill: #ffd700;
  stroke: #ffd700;
  opacity: 0.8;
}

#hamburger-menu-icon:hover svg #patty path {
  fill: #6B4423;
  stroke: #6B4423;
  opacity: 0.8;
}

#hamburger-menu-icon:hover svg #btm_bun {
  fill: #d4a574;
  stroke: #d4a574;
  opacity: 0.8;
}

#hamburger-menu-icon:hover svg #top_bun {
  fill: #d4a574;
  /* stroke: #d4a574; */
  opacity: 0.8;
}

#hamburger-menu-icon:hover svg #seeds path {
  fill: #e6e3bfff;
  stroke: #e6e3bfff;
  opacity: 0.8;
}

</style>

