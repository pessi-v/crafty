<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
	<head>
		<meta charset="utf-8"/>
		<title>{{ siteName }}</title>
		<meta content="width=device-width, initial-scale=1.0" name="viewport">

		{% do craft.app.view.registerCssFile('@web/styles.css') %}

	</head>
	<body>
		{# Get the first segment of the current URI: #}
		{% set navSegment = craft.app.request.getSegment(1) %}
		<header>
			<a class="home" href="{{ siteUrl }}">{{ siteName }}</a>
			<nav>
				<ul>
					{# comment #}
					<li>
						<a href="{{ url('/') }}" class="{{ navSegment is empty ? 'active' : 'inactive' }}">Home</a>
					</li>
					<li>
						<a href="{{ url('blog') }}" class="{{ navSegment == 'blog' ? 'active' : 'inactive' }}">Blog</a>
					</li>
					<li>
						<a href="{{ url('about') }}" class="{{ navSegment == 'about' ? 'active' : 'inactive' }}">About</a>
					</li>
				</ul>
			</nav>
		</header>
		<main>
			{% block content %}
				{# Nothing here, yet! #}
			{% endblock %}
		</main>
		<footer>
			<div class="description">
				{{ siteInfo.description | md }}
			</div>
			<div class="copyright">&copy;{{ now | date('Y') }}
				{{ siteName }}</div>
			<div class="colophon">Built with
				<a href="https://craftcms.com/" target="_blank">Craft CMS</a>
			</div>
		</footer>
	</body>
</html>
