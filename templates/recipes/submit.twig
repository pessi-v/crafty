{% extends "_layout" %}

{% block content %}
<div class="recipe-submit-container">
  <h1>Submit a Recipe</h1>

  {% if craft.app.session.hasFlash('notice') %}
    <div class="notice">
      {{ craft.app.session.getFlash('notice') }}
    </div>
  {% endif %}

  {% if craft.app.session.hasFlash('error') %}
    <div class="error">
      {{ craft.app.session.getFlash('error') }}
    </div>
  {% endif %}

  <form method="post" enctype="multipart/form-data" id="recipe-form" autocomplete="off">
    {{ csrfInput() }}
    {{ actionInput('recipesmodule/recipes/submit') }}

    <div class="form-group">
      <label for="title" class="form-label">
        Recipe Title
      </label>
      <input
        type="text"
        id="title"
        name="title"
        required
        autocomplete="off"
        class="form-input"
      >
    </div>

    <div class="form-group">
      <label class="form-label">Categories</label>
      {% set allCategories = craft.categories().group('labels').all() %}
      <div class="categories-container">
        {% for category in allCategories %}
          <label class="category-checkbox-label">
            <input
              type="checkbox"
              name="categories[]"
              value="{{ category.id }}"
            >
            {{ category.title }}
          </label>
        {% endfor %}
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Recipe Content</label>
      <div id="content-blocks">
        {# Content blocks will be added here dynamically #}
      </div>
    
      <div class="content-block-header">
        {# <strong>Text Block</strong> #}
      {# <button type="button" class="remove-block" style="background: #dc3545; color: white; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer;">Remove</button> #}
      </div>
      <input type="hidden" name="contentBlocks[0][text]" value="text">
      <textarea
        name="contentBlocks[0][text]"
        rows="4"
        class="form-input"
        placeholder="Enter text content..."
      ></textarea>
    </div>

    <div class="form-group">
      <label for="salasana" class="form-label">
        Password
      </label>
      <input
        type="salasana"
        id="salasana"
        name="salasana"
        required
        autocomplete="off"
        class="form-input"
      >
      <small class="form-helper-text">Enter the submission password</small>
    </div>

    <button type="submit" class="submit-button">
      Submit Recipe
    </button>
    <p class="form-note">
      <em>Note: Your recipe will be reviewed before it appears on the site.</em>
    </p>
  </form>
</div>

{% endblock %}
