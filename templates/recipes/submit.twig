{% extends "_layout" %}

{% block content %}
<div class="recipe-submit-container" style="max-width: 800px; margin: 0 auto;">
  <h1>Submit a Recipe</h1>

  {% if craft.app.session.hasFlash('notice') %}
    <div class="notice" style="background: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 1rem; margin-bottom: 1rem; border-radius: 4px;">
      {{ craft.app.session.getFlash('notice') }}
    </div>
  {% endif %}

  {% if craft.app.session.hasFlash('error') %}
    <div class="error" style="background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 1rem; margin-bottom: 1rem; border-radius: 4px;">
      {{ craft.app.session.getFlash('error') }}
    </div>
  {% endif %}

  <form method="post" enctype="multipart/form-data" id="recipe-form" autocomplete="off">
    {{ csrfInput() }}
    {{ actionInput('recipesmodule/recipes/submit') }}

    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="title" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">
        Recipe Title
      </label>
      <input
        type="text"
        id="title"
        name="title"
        required
        autocomplete="off"
        style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;"
      >
    </div>

    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Categories</label>
      {% set allCategories = craft.categories().group('labels').all() %}
      <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
        {% for category in allCategories %}
          <label style="display: flex; align-items: center; gap: 0.5rem;">
            <input
              type="checkbox"
              name="categories[]"
              value="{{ category.id }}"
            >
            {{ category.title }}
          </label>
        {% endfor %}
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Recipe Content</label>
      <div id="content-blocks">
        {# Content blocks will be added here dynamically #}
      </div>
      <div style="display: flex; gap: 1rem; margin-top: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <strong>Text Block</strong>
        {# <button type="button" class="remove-block" style="background: #dc3545; color: white; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer;">Remove</button> #}
        </div>
        <input type="hidden" name="contentBlocks[0][text]" value="text">
        <textarea
          name="contentBlocks[0][text]"
          rows="4"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;"
          placeholder="Enter text content..."
        ></textarea>
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="salasana" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">
        Password
      </label>
      <input
        type="salasana"
        id="salasana"
        name="salasana"
        required
        autocomplete="off"
        style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;"
      >
      <small style="color: #666;">Enter the submission password</small>
    </div>

    <button type="submit" style="padding: 0.75rem 2rem; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; font-weight: bold;">
      Submit Recipe
    </button>
    <p style="margin-top: 1rem; color: #666; font-size: 0.9rem;">
      <em>Note: Your recipe will be reviewed before it appears on the site.</em>
    </p>
  </form>
</div>

{% endblock %}
