{# AJAX endpoint for rendering modal content #}
{# Expects: view (all|spicy|detail|any-category-slug), recipeId (for detail view), listTitle #}

{% set view = craft.app.request.getParam('view') %}
{% set listTitle = craft.app.request.getParam('listTitle') %}

{# Map 3D object view names to category slugs (special cases only) #}
{% set categoryMap = {
  'chili': 'spicy',
  'egg': 'egg',
  'pig': 'meat',
  'eggplant': ['vegetarian', 'vegan'],
  'peapod': 'tofu',
  'garlic': 'garlicky'
} %}

{% if view == 'categories' %}
  {# Query all categories #}
  {% set categories = craft.categories()
    .group('labels')
    .all() %}

{% elseif view == 'all' %}
  {# Query all recipes #}
  {% set recipes = craft.entries()
    .section('recipes')
    .all() %}

{% elseif view in categoryMap|keys %}
  {# Query recipes by mapped category (for 3D satellites) #}
  {% set categorySlugs = categoryMap[view] %}
  {% set query = craft.entries().section('recipes') %}

  {% if categorySlugs is iterable and categorySlugs is not string %}
    {# Multiple categories - use OR logic #}
    {% set categoryElements = [] %}
    {% for slug in categorySlugs %}
      {% set categoryElements = categoryElements|merge([craft.categories().slug(slug).one()]) %}
    {% endfor %}
    {% set recipes = query.relatedTo(categoryElements).all() %}
  {% else %}
    {# Single category #}
    {% set recipes = query.relatedTo({
      targetElement: craft.categories().slug(categorySlugs).one()
    }).all() %}
  {% endif %}

{% else %}
  {# Generic category query - treat view as category slug #}
  {% set category = craft.categories().slug(view).one() %}
  {% if category %}
    {% set recipes = craft.entries()
      .section('recipes')
      .relatedTo({
        targetElement: category
      })
      .all() %}
  {% else %}
    {% set recipes = [] %}
  {% endif %}

{% endif %}

{# Render modal content based on view type #}
{% if view == 'categories' and categories is defined %}
  {% include 'recipes/_modal-categories' with {
    categories: categories,
    listTitle: listTitle
  } %}
{% elseif view != 'detail' and recipes is defined %}
  {% include 'recipes/_modal-list' with {
    recipes: recipes,
    listTitle: listTitle
  } %}
{% elseif view == 'detail' %}
  {# Render single recipe detail #}
  {% set recipeId = craft.app.request.getParam('recipeId') %}
  {% set recipeSlug = craft.app.request.getParam('recipeSlug') %}

  {# Query by slug first (for URLs), fallback to ID (for internal clicks) #}
  {% if recipeSlug %}
    {% set recipe = craft.entries()
      .section('recipes')
      .slug(recipeSlug)
      .one() %}
  {% elseif recipeId %}
    {% set recipe = craft.entries()
      .section('recipes')
      .id(recipeId)
      .one() %}
  {% endif %}

  {% if recipe %}
    {% include 'recipes/_modal-detail' with {
      recipe: recipe,
      listTitle: listTitle
    } %}
  {% else %}
    <p>Recipe not found</p>
  {% endif %}

{% endif %}
