{# AJAX endpoint for rendering modal content #}
{# Expects: view (all|spicy|detail), recipeId (for detail view), listTitle #}

{% set view = craft.app.request.getParam('view') %}
{% set listTitle = craft.app.request.getParam('listTitle') %}

{% if view == 'all' %}
  {# Query all recipes #}
  {% set recipes = craft.entries()
    .section('recipes')
    .all() %}

  {% include 'recipes/_modal-list' with {
    recipes: recipes,
    listTitle: listTitle
  } %}

{% elseif view == 'spicy' %}
  {# Query spicy recipes #}
  {% set recipes = craft.entries()
    .section('recipes')
    .relatedTo({
      targetElement: craft.categories().slug('spicy').one()
    })
    .all() %}

  {% include 'recipes/_modal-list' with {
    recipes: recipes,
    listTitle: listTitle
  } %}

{% elseif view == 'egg' %}
  {# Query egg recipes #}
  {% set recipes = craft.entries()
    .section('recipes')
    .relatedTo({
      targetElement: craft.categories().slug('egg').one()
    })
    .all() %}

  {% include 'recipes/_modal-list' with {
    recipes: recipes,
    listTitle: listTitle
  } %}

{% elseif view == 'garlic' %}
  {# Query garlic recipes #}
  {% set recipes = craft.entries()
    .section('recipes')
    .relatedTo({
      targetElement: craft.categories().slug('garlic').one()
    })
    .all() %}

  {% include 'recipes/_modal-list' with {
    recipes: recipes,
    listTitle: listTitle
  } %}

{% elseif view == 'detail' %}
  {# Render single recipe detail #}
  {% set recipeId = craft.app.request.getParam('recipeId') %}
  {% set recipe = craft.entries()
    .section('recipes')
    .id(recipeId)
    .one() %}

  {% if recipe %}
    {% include 'recipes/_modal-detail' with {
      recipe: recipe,
      listTitle: listTitle
    } %}
  {% else %}
    <p>Recipe not found</p>
  {% endif %}

{% endif %}
