{# Unified hamburger menu view for modal #}
{# Expected variables: categories, recipes, listTitle #}

<div class="flex flex-col gap-1">
  <h2 class="capitalize text-4xl">{{ listTitle }}</h2>

  {# All Categories Section #}
  {% if categories|length %}
    <div>
      <h3 class="text-2xl mb-2">All Categories</h3>
      <div class="categories-modal__categories flex flex-wrap">
        {% for category in categories %}
          <div class="recipe-categories__tag clickable capitalize" data-category-slug="{{ category.slug }}">
            {{ category.title }}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# Search Section #}
  <div class="modal-search">
    <div class="modal-search__divider"></div>
    <h3 class="text-2xl mb-2">Search Recipes</h3>
    <div class="modal-search__input-wrapper">
      <input
        type="text"
        id="recipe-search-input"
        class="modal-search__input"
        placeholder="Search by recipe name or content..."
        autocomplete="off"
      />
      <button id="search-clear-button" class="modal-search__clear hidden clickable" aria-label="Clear search">×</button>
    </div>
    <div id="search-results-container" class="modal-search__results">
      {# Search results will be loaded here via AJAX #}
    </div>
  </div>

  {# All Recipes Section (shown when search is empty) #}
  <div id="all-recipes-section" class="hamburger-modal__all-recipes">
    <h3 class="text-2xl mb-2">All Recipes</h3>
    {% if recipes|length %}
      <ul class="grid gap-3">
        {% for recipe in recipes %}
          <li class="recipe-list-item" data-recipe-id="{{ recipe.id }}" data-recipe-slug="{{ recipe.slug }}">
            <h3 class="clickable inline-block capitalize text-lg font-semibold">{{ recipe.title }}</h3>
            {% if recipe.recipeCategories|length %}
              <div class="recipe-categories">
                {% for category in recipe.recipeCategories.all() %}
                  <div class="recipe-categories__tag clickable" data-category-slug="{{ category.slug }}">{{ category.title }}</div>
                {% endfor %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>No recipes found</p>
    {% endif %}
  </div>
</div>
