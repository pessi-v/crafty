{# Search results view for modal #}
{# Expected variables: recipes, searchQuery #}

<div class="flex flex-col gap-4">
  <h2 class="capitalize text-4xl">Search Results</h2>

  {% if searchQuery and searchQuery|trim %}
    <p class="text-sm text-gray-600">Showing results for: "{{ searchQuery }}"</p>

    {% if recipes|length %}
      <ul class="grid gap-3">
        {% for recipe in recipes %}
          <li class="recipe-list-item" data-recipe-id="{{ recipe.id }}" data-recipe-slug="{{ recipe.slug }}">
            <h3 class="clickable inline-block capitalize text-lg font-semibold">{{ recipe.title }}</h3>
            {% if recipe.recipeCategories|length %}
              <div class="recipe-categories">
                {% for category in recipe.recipeCategories.all() %}
                  <div class="recipe-categories__tag clickable" data-category-slug="{{ category.slug }}">{{ category.title }}</div>
                {% endfor %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="text-gray-500 italic">No recipes found matching "{{ searchQuery }}"</p>
    {% endif %}
  {% else %}
    <p class="text-gray-500 italic">Enter a search term to find recipes</p>
  {% endif %}

</div>
