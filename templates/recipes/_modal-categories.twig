{# All categories view for modal #}
{# Expected variables: categories, listTitle #}

<h1 class="modal-title">{{ listTitle }}</h1>

{% if categories|length %}
  <div class="categories-grid">
    {% for category in categories %}
      <div class="recipe-category-tag clickable" data-category-slug="{{ category.slug }}">
        <h3>{{ category.title }}</h3>
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>No categories found</p>
{% endif %}
