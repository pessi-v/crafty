{# All categories view for modal #}
{# Expected variables: categories, listTitle #}

<div class="flex flex-col gap-4">
  <h2 class="capitalize text-4xl">{{ listTitle }}</h2>

  {% if categories|length %}
    <div class="categories-modal__categories flex flex-wrap">
      {% for category in categories %}
        <div class="recipe-categories__tag clickable capitalize" data-category-slug="{{ category.slug }}">
          {{ category.title }}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p>No categories found</p>
  {% endif %}

  {# Search Section #}
  <div class="modal-search">
    <div class="modal-search__divider"></div>

    <h3 class="text-2xl mb-2">Search Recipes</h3>

    <div class="modal-search__input-wrapper">
      <input
        type="text"
        id="recipe-search-input"
        class="modal-search__input"
        placeholder="Search by recipe name or content..."
        autocomplete="off"
      />
      <span class="modal-search__loading hidden">Searching...</span>
    </div>

    <div id="search-results-container" class="modal-search__results">
      {# Search results will be loaded here via AJAX #}
    </div>
  </div>
</div>