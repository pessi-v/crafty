{# Recipe list view for modal #}
{# Expected variables: recipes, listTitle #}

<h1 class="modal-title">{{ listTitle }}</h1>
{# <div class="recipe-list"> #}
  {% if recipes|length %}
    <ul>
      {% for recipe in recipes %}
        <li class="recipe-list-item" data-recipe-id="{{ recipe.id }}">
          <h3>{{ recipe.title }}</h3>
          {% if recipe.recipeCategories|length %}
            <div class="recipe-categories">
              {% for category in recipe.recipeCategories.all() %}
                <div class="recipe-category-tag">{{ category.title }}</div>
              {% endfor %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No recipes found</p>
  {% endif %}
{# </div> #}
