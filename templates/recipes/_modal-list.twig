{# Recipe list view for modal #}
{# Expected variables: recipes, listTitle #}

<h2 class="capitalize text-4xl">{{ listTitle }}</h2>
{# <div class="recipe-list"> #}
  {% if recipes|length %}
    <ul>
      {% for recipe in recipes %}
        <li class="recipe-list-item" data-recipe-id="{{ recipe.id }}" data-recipe-slug="{{ recipe.slug }}">
          <h3 class="clickable inline-block">{{ recipe.title }}</h3>
          {% if recipe.recipeCategories|length %}
            <div class="recipe-categories">
              {% for category in recipe.recipeCategories.all() %}
                <div class="recipe-category-tag clickable" data-category-slug="{{ category.slug }}">{{ category.title }}</div>
              {% endfor %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No recipes found</p>
  {% endif %}
{# </div> #}
