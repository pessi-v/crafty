{% extends "_layout.twig" %}

{% block content %}

<div id="animation-container">
</div>

{# Recipe Modal using Modal Component plugin #}
{% embed 'snippets-modal/modal' with {
  modalId: 'recipe-modal',
} %}
  {% block content %}
    <div id="modal-inner">
    </div>
  {% endblock %}
{% endembed %}

<script type="module">
  import { initAnimation } from '/animation.js?v={{ '/animation.js'|hash }}';
  import { initModal } from '/modal.js?v={{ '/modal.js'|hash }}';

  // Initialize modal system with AJAX URL
  initModal({
    ajaxUrl: '{{ siteUrl('recipes/ajax-modal') }}'
  });

  // Configuration object with Twig variables
  const animationConfig = {
    baseUrl: "{{ siteUrl }}",
    clickableObjects: {
      turnip: {
        name: "Turnip Planet",
        type: "list",
        view: "all",
        listTitle: "All Recipes"
      },
      chili: {
        name: "Chili Satellite",
        type: "list",
        view: "spicy",
        listTitle: "Spicy Recipes"
      },
      egg: {
        name: "Egg Satellite",
        type: "list",
        view: "egg",
        listTitle: "Egg Recipes"
      },
      garlic: {
        name: "Garlic Satellite",
        type: "list",
        view: "garlic",
        listTitle: "Garlic Recipes"
      },
      peapod: {
        name: "Peapod Satellite",
        type: "list",
        view: "peapod",
        listTitle: "Tofu Recipes"
      },
      eggplant: {
        name: "Eggplant Satellite",
        type: "list",
        view: "eggplant",
        listTitle: "Vegan and Vegetarian Recipes"
      },
      pig: {
        name: "Pig Satellite",
        type: "list",
        view: "pig",
        listTitle: "Meat Recipes"
      },
      pepper_grinder: {
        name: "Pepper Grinder Satellite",
        type: "form",
        url: "{{ siteUrl('recipes/submit') }}",
        listTitle: "Submit a Recipe"
      },
    },
  };

  // Initialize the animation
  initAnimation(animationConfig);
</script>
{% endblock %}
