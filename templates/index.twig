{% extends "_layout.twig" %}

{% block content %}

<div id="animation-container">
</div>

{# Recipe Modal using Modal Component plugin #}
{% embed 'snippets-modal/modal' with {
  modalId: 'recipe-modal',
} %}
  {% block content %}
    <div class="w-11/12 md:w-96" id="modal-inner">
    </div>
  {% endblock %}
{% endembed %}

<script type="module">
  import { initAnimation } from '/animation.js?v={{ '/animation.js'|hash }}';

  // Initialize modal system with AJAX URL (initModal is loaded via main.js)
  window.initModal({
    ajaxUrl: '{{ siteUrl('recipes/ajax-modal') }}'
  });

  // Configuration object with Twig variables
  const animationConfig = {
    baseUrl: "{{ siteUrl }}",
    clickableObjects: {
      turnip: {
        name: "Turnip Planet",
        type: "form",
        url: "{{ siteUrl('recipes/submit') }}",
        listTitle: "Submit a Recipe"
      },
      chili: {
        name: "Chili Satellite",
        type: "list",
        view: "chili",
        listTitle: "Spicy Recipes"
      },
      egg: {
        name: "Egg Satellite",
        type: "list",
        view: "egg",
        listTitle: "Egg Recipes"
      },
      garlic: {
        name: "Garlic Satellite",
        type: "list",
        view: "garlicky",
        listTitle: "Garlicky Recipes"
      },
      peapod: {
        name: "Peapod Satellite",
        type: "list",
        view: "peapod",
        listTitle: "Tofu Recipes"
      },
      eggplant: {
        name: "Eggplant Satellite",
        type: "list",
        view: "eggplant",
        listTitle: "Vegan and Vegetarian Recipes"
      },
      pig: {
        name: "Pig Satellite",
        type: "list",
        view: "pig",
        listTitle: "Meat Recipes"
      },
      hamburger: {
        name: "Hamburger Satellite",
        type: "list",
        view: "hamburger",
        listTitle: "Browse Recipes"
      },
    },
  };

  // Initialize the animation
  initAnimation(animationConfig);

  // Add click handler for hamburger menu icon
  document.getElementById('hamburger-menu-icon').addEventListener('click', function() {
    window.openModal({
      type: "list",
      view: "hamburger",
      listTitle: "Browse Recipes"
    });
  });
</script>
{% endblock %}
