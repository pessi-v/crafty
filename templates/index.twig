{% extends "_layout.twig" %}

{% block content %}
<style>
  body {
    margin: 0;
    overflow: hidden;
  }
  #animation-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: linear-gradient(
      to bottom,
      #0a0a1a 0%,
      #1a1a3a 50%,
      #2a1a3a 100%
    );
    z-index: -1;
  }
  #animation-container canvas {
    display: block;
    cursor: default;
  }
  #animation-container canvas.pointer {
    cursor: pointer;
  }

</style>

<div id="animation-container">
</div>

<script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
    }
  }
</script>

<script type="module">
  import { initAnimation } from "{{ siteUrl }}animation.js";

  // Configuration object with Twig variables
  const animationConfig = {
    baseUrl: "{{ siteUrl }}",
    clickableObjects: {
      turnip: {
        url: "{{ entry.turnipUrl ?? 'https://example.com/planet' }}",
        name: "Turnip Planet",
      },
      chili: {
        url: "{{ entry.chiliUrl ?? 'https://example.com/chili' }}",
        name: "Chili Satellite",
      },
      egg: {
        url: "{{ entry.eggUrl ?? 'https://example.com/egg' }}",
        name: "Egg Satellite",
      },
      garlic: {
        url: "{{ entry.garlicUrl ?? 'https://example.com/garlic' }}",
        name: "Garlic Satellite",
      },
    },
  };

  // Initialize the animation
  initAnimation(animationConfig);
</script>
{% endblock %}
